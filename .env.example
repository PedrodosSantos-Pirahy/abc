# --------------------------------------------------------------------------
# Servidor
# --------------------------------------------------------------------------
HOST=0.0.0.0
PORT=5010
NODE_ENV=development

# Origens liberadas no CORS em produção (separadas por vírgula).
# Em desenvolvimento (NODE_ENV != production) qualquer origem é aceita.
# Lista igual à _ORIGENS_PERMITIDAS do main.py (Flask) — mesmas origens que
# hoje já batem no backend antigo.
CORS_ORIGIN=https://manutencao.pirahy.ind.br,http://192.168.10.227,http://192.168.10.227:4200,http://192.168.43.93,http://192.168.43.93:4200,https://192.168.43.93:4200,http://localhost,http://localhost:4200,https://localhost:4200

# --------------------------------------------------------------------------
# PostgreSQL — MESMA instância/credenciais já usadas pelo backend Flask
# (ver frontend/API/.env). Continuamos batendo no schema "manut" do ERP.
# --------------------------------------------------------------------------
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=5432

# --------------------------------------------------------------------------
# MongoDB — usado só para gravar o log de requisições (requestLogger).
# --------------------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017/manutencao_logs

# --------------------------------------------------------------------------
# Redis — infraestrutura de cache/sessão para fases futuras.
# --------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
